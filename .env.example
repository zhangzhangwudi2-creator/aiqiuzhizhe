DEEPSEEK_API_KEY=your_deepseek_api_key
# Optional, comma-separated. Same-origin deployment does not need this.
CORS_ORIGINS=http://localhost:3000
# Cost protection defaults: 5 uncached AI calls per IP per hour.
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=3600
CACHE_TTL_SECONDS=21600
# Behind Railway/nginx keep true: the rightmost X-Forwarded-For hop is added
# by the proxy and cannot be spoofed. Set to false only when the app is
# exposed directly to clients without any proxy.
TRUST_X_FORWARDED_FOR=true
